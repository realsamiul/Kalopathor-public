# ─────────────────────────────────────────────────────────────────────────────
# Kalopathor environment variables
#
# *** THE FRONTEND (frontend/) NEEDS NO ENVIRONMENT VARIABLES. ***
# It is a static Next.js app; all data is served from public/data/.
# For Vercel: import the repo, set Root Directory = "frontend", deploy.
# The only optional frontend variable is documented in frontend/.env.example.
#
# The variables below are for the BACKEND/DATA PIPELINE only (training,
# data generation and freshness jobs run on workstations / the OVH server).
# They must never be committed with real values, and never set in Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# --- backend pipeline only (not required for the frontend) ---
LIGHTNING_API_KEY=             # Lightning AI API key (training compute)
GITHUB_TOKEN=                  # GitHub PAT (data sync jobs)
GOOGLE_APPLICATION_CREDENTIALS=  # Path to GCP service account JSON
GOOGLE_CLOUD_PROJECT=          # GCP project ID (Earth Engine / storage)
MODAL_TOKEN_ID=                # Modal.com token ID (serverless jobs)
MODAL_TOKEN_SECRET=            # Modal.com token secret
AWS_ACCESS_KEY_ID=             # AWS credentials (COG / bucket access)
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# --- repo owner only ---
VERCEL_TOKEN=                  # Vercel token (CI-driven deploys)
