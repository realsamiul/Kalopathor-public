{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalopathor:alert:v0.1.0",
  "title": "Alert",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "model_version",
    "pipeline_version",
    "alert_id",
    "alert_type",
    "language",
    "severity",
    "urgency",
    "certainty",
    "confidence_class",
    "district",
    "affected_people",
    "status",
    "evidence_trail",
    "messages",
    "data_flag"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "pipeline_version": {
      "type": "string"
    },
    "alert_id": {
      "type": "string"
    },
    "alert_type": {
      "type": "string"
    },
    "language": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string"
    },
    "urgency": {
      "type": "string"
    },
    "certainty": {
      "type": "string"
    },
    "confidence_class": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "division": {
      "type": "string"
    },
    "affected_people": {
      "type": "integer"
    },
    "go_before": {
      "type": "string"
    },
    "shelter_name": {
      "type": "string"
    },
    "route_id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "evidence_trail": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "flag",
          "detail"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "flag": {
            "enum": [
              "real",
              "derived",
              "proxy",
              "missing"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "messages": {
      "type": "object"
    },
    "data_flag": {
      "enum": [
        "real",
        "derived",
        "proxy",
        "missing"
      ]
    },
    "source": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "valid_from": {
      "type": "string"
    },
    "valid_until": {
      "type": "string"
    },
    "crs": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "review_status": {
      "type": "string"
    }
  }
}
