{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kalopathor:data_freshness:v0.1.0",
  "title": "Data Freshness",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "model_version",
    "pipeline_version",
    "components",
    "generated_at",
    "data_flag"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "pipeline_version": {
      "type": "string"
    },
    "components": {
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    },
    "data_flag": {
      "enum": [
        "real",
        "derived",
        "proxy",
        "missing"
      ]
    },
    "crs": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "review_status": {
      "type": "string"
    }
  }
}
